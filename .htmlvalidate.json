{
  "extends": ["html-validate:recommended", "html-validate:a11y"],
  "rules": {
    "doctype-style": ["error", { "style": "lowercase" }],
    "no-inline-style": ["error", { "allowedProperties": ["--v", "--lo", "--hi", "--min", "--max", "--n"] }],
    "prefer-native-element": ["error", { "exclude": ["region"] }],
    "require-sri": "off"
  }
}
